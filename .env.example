# ─────────────────────────────────────────────────────────────────────────────
# AgriSmart — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Flask
FLASK_SECRET=change-me-to-a-long-random-string
FLASK_ENV=production

# Google Gemini AI (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenWeatherMap (https://openweathermap.org/api)
OPENWEATHER_API_KEY=your-openweather-api-key-here

# Admin credentials (for /admin dashboard)
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ─── Google Drive Model File IDs ──────────────────────────────────────────────
# Upload each .h5 / .pt model to Google Drive, set sharing to "Anyone with link",
# then paste the file ID from the share URL below.
# File ID is the long string in: https://drive.google.com/file/d/<FILE_ID>/view
SOIL_MODEL_GDRIVE_ID=your-soil-classifier-h5-file-id
LEAF_MODEL_GDRIVE_ID=your-leaf-disease-mobilenet-finetuned-h5-file-id
YOLO_MODEL_GDRIVE_ID=your-yolov8n-pt-file-id
